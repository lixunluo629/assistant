<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      权限只有相机。

      下面的 INTERNET / ACCESS_NETWORK_STATE 是 ML Kit 依赖库自己声明的，
      manifest merger 会把它们合并进来。这里显式 remove 掉：
      没有网络权限，本 App 在系统层面就不可能把二维码内容上传出去，
      这比"我们承诺不上传"更可靠。
      跳应用商店用的是 market:// 链接，由商店 App 自己去联网；
      二维码解码用 bundled 版 ML Kit 模型，完全离线可跑。
      构建后用 `aapt2 dump permissions` 或 `apkanalyzer manifest permissions` 验证。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Android 11+ 的包可见性限制：不在这里声明，getPackageInfo 会一律抛
      NameNotFoundException，安装检测就会把"已安装"误判成"未安装"。
      规则表里 android_packages 有变动时，这里必须同步增删。
      官方文档：https://developer.android.com/training/package-visibility
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.alibaba.android.rimet" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.tencent.wework" />
        <package android:name="com.baidu.searchbox" />
        <package android:name="com.quark.browser" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.valvesoftware.android.steam.community" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="dingtalk" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqq" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqqapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="alipays" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bilibili" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wxwork" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wxworkapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="baiduboxapp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bdbox" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="quark" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="uclink" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="qklink" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="xhsdiscover" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="snssdk1128" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="steam" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- 首页：功能菜单（唯一的入口 Activity） -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 功能：扫码登录助手（从首页进入，不对外导出） -->
        <activity
            android:name=".feature.scan.ScanActivity"
            android:exported="false"
            android:label="@string/tool_scan_login_title"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 功能：手气盒子 -->
        <activity
            android:name=".feature.random.RandomActivity"
            android:exported="false"
            android:label="@string/tool_random_title"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
