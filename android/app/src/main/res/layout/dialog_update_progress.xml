<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tool_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/updateProgressTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_downloading"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/updateProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:indeterminate="false"
        android:indeterminateTint="@color/menu_accent"
        android:max="100"
        android:minHeight="8dp"
        android:progress="0"
        android:progressBackgroundTint="@color/card_stroke"
        android:progressTint="@color/menu_accent" />

    <TextView
        android:id="@+id/updateProgressLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/updateProgressHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/update_cancel_hint"
        android:textColor="@color/on_surface_muted"
        android:textSize="13sp" />
</LinearLayout>
